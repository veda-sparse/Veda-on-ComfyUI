#!/bin/sh
# Blocks commit messages with secrets or machine-local information, and
# co-author / tool attribution lines (AGENTS.md 1.2, 1.3).
. "$(git rev-parse --show-toplevel)/.githooks/leak_patterns.sh"
msg="$(mktemp)"
trap 'rm -f "$msg"' EXIT
grep -v '^#' "$1" > "$msg"
hits="$(leak_scan "$msg" message)"
attribution="$(grep -niE '^(co-authored-by|generated with|signed-off-by: .*noreply)' "$msg")"
if [ -n "$hits$attribution" ]; then
    echo "commit-msg: rejected (AGENTS.md 1.2 / 1.3):" >&2
    printf '%s\n%s\n' "$hits" "$attribution" | grep -v '^$' | cut -c1-200 >&2
    exit 1
fi
