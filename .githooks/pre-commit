#!/bin/sh
# Blocks commits whose added lines contain secrets or machine-local
# information (AGENTS.md 1.3). Generated vendor code is exempt (it is
# rebuilt from a hash-pinned upstream wheel by tools/vendor_fa4.py).
. "$(git rev-parse --show-toplevel)/.githooks/leak_patterns.sh"
added="$(mktemp)"
trap 'rm -f "$added"' EXIT
# One line per added line: "<file>: <text>".
git diff --cached -U0 --no-color --diff-filter=ACMR -- . \
        ':(exclude)veda_comfy/_vendor' |
    awk '/^\+\+\+ /{file=substr($0, 7); next} /^\+/{print file ": " substr($0, 2)}' \
    > "$added"
hits="$(leak_scan "$added" staged)"
if [ -n "$hits" ]; then
    echo "pre-commit: possible secret or local information (AGENTS.md 1.3):" >&2
    echo "$hits" | cut -c1-200 >&2
    echo "Remove it, or use --no-verify only for a confirmed false positive." >&2
    exit 1
fi
