+def _tile_size_fwd_sm8x_block_sparse(
+    head_dim: int,
+    head_dim_v: int,
+    sparse_block_size: Optional[Tuple[int, int]],
+) -> FwdConfig:
+    """Forward tile for block-sparse attention on the SM80-family path (sm80/86/89).
+
+    A coarse sparse block (e.g. 128 x 128) is covered by q_subtile_factor x kv_subtile_factor
+    tiles. Measured on RTX 4090 (hdim 128, 90% sparsity, 128 x 128 sparse blocks): 128 x 32
+    (kv_subtile_factor 4, 48 KB smem -> 2 CTAs/SM) > 64 x 64 (~2-4% slower) > 128 x 64
+    (1 CTA/SM, ~10-15% slower); 128 x 128 with 4 warps spills registers (~30x slower).
+    Without an explicit block_size the sparse KV block is assumed to equal tile_n, so keep the
+    historical 128 x 64 tile in that case.
+    """
+    if sparse_block_size is None:
+        return FwdConfig(128, 64, True, True)
+    sparse_q, sparse_kv = sparse_block_size
+    tile_m = 128 if sparse_q % 128 == 0 else 64
+    if max(head_dim, head_dim_v) <= 128 and tile_m == 128 and sparse_kv % 32 == 0:
+        tile_n = 32
+    elif sparse_kv % 64 == 0:
+        tile_n = 64
