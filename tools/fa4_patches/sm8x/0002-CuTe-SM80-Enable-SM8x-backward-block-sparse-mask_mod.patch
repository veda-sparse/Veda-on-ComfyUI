index 2c50236..43314f7 100644
--- a/flash_attn/cute/block_sparsity.py
+++ b/flash_attn/cute/block_sparsity.py
@@ -77,6 +77,48 @@ def _ordered_to_dense_simple(
     return dense[:, :, :, :num_cols]
 
 
+def _dense_to_ordered_simple(dense: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Inverse of _ordered_to_dense_simple: [B, H, R, C] 0/1 -> (cnt [B, H, R], idx [B, H, R, C]).
+
+    Valid column indices are packed left in ascending order (FlexAttention BlockMask layout).
+    """
+    dense = dense.contiguous()
+    cnt = dense.sum(dim=-1, dtype=torch.int32)
+    idx = torch.argsort(dense.to(torch.int8), dim=-1, descending=True, stable=True)
+    return cnt.contiguous(), idx.to(torch.int32).contiguous()
+
+
+def block_sparse_tensors_fwd_to_bwd(
+    tensors: BlockSparseTensorsTorch,
+    num_q_blocks: int,
+    num_kv_blocks: int,
+) -> BlockSparseTensorsTorch:
+    """Transpose forward (KV-direction) block lists into backward (Q-direction) lists.
+
+    ``tensors`` holds, per (batch, head, q_block), the partial ("mask") and full KV block lists.
+    The result holds, per (batch, head, kv_block), the partial and full Q block lists, as
+    expected by ``block_sparse_tensors_bwd``. Uses dense [B, H, num_q_blocks, num_kv_blocks]
+    intermediates (fine for up to a few thousand blocks per side).
+    """
+    mask_dense = _ordered_to_dense_simple(
+        tensors.mask_block_cnt, tensors.mask_block_idx, num_kv_blocks
+    )[:, :, :num_q_blocks]
+    q_mask_cnt, q_mask_idx = _dense_to_ordered_simple(mask_dense.transpose(-1, -2))
+    q_full_cnt = q_full_idx = None
+    if tensors.full_block_cnt is not None:
+        full_dense = _ordered_to_dense_simple(
+            tensors.full_block_cnt, tensors.full_block_idx, num_kv_blocks
+        )[:, :, :num_q_blocks]
+        q_full_cnt, q_full_idx = _dense_to_ordered_simple(full_dense.transpose(-1, -2))
+    return BlockSparseTensorsTorch(
+        mask_block_cnt=q_mask_cnt,
+        mask_block_idx=q_mask_idx,
+        full_block_cnt=q_full_cnt,
+        full_block_idx=q_full_idx,
+        block_size=tensors.block_size,
+    )
+
+
 def compute_dq_write_order(
     fwd_mask_cnt: torch.Tensor,
     fwd_mask_idx: torch.Tensor,
