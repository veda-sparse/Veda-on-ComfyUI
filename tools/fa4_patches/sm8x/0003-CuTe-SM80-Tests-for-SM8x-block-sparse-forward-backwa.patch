From: MarsTechHAN <hansh-sz@hotmail.com>
Date: Wed, 23 Sep 2026 22:09:25 +0800
Subject: [PATCH 3/5] [CuTe, SM80] Tests for SM8x block-sparse forward/backward

Forward vs an fp32 token-level reference (partial blocks masked by an aux
key-validity mask_mod, full blocks unmasked, empty rows, seqlen tails incl.
fully out-of-bounds KV sub-tiles, several tiles), a guard that the output is
not dense attention, no recompilation across patterns, backward vs autograd
reference, and the missing block_sparse_tensors_bwd error.
---
 tests/cute/test_block_sparsity_sm8x.py | 154 +++++++++++++++++++++++++
 1 file changed, 154 insertions(+)
 create mode 100644 tests/cute/test_block_sparsity_sm8x.py

diff --git a/tests/cute/test_block_sparsity_sm8x.py b/tests/cute/test_block_sparsity_sm8x.py
new file mode 100644
index 0000000..6698da7
--- /dev/null
+++ b/tests/cute/test_block_sparsity_sm8x.py
@@ -0,0 +1,154 @@
+"""Block-sparse forward/backward on the SM80-family path (sm80/86/89).
+
+Guards against the former silent dense fallback: FlashAttentionForwardSm80 /
+FlashAttentionBackwardSm80 used to accept blocksparse_tensors and ignore them.
+"""
+import math
+
+import pytest
+import torch
+
+import cutlass
+import cutlass.cute as cute
+
+from flash_attn.cute import utils as fa_utils
+from flash_attn.cute.block_sparsity import (
+    BlockSparseTensorsTorch,
+    block_sparse_tensors_fwd_to_bwd,
+)
+from flash_attn.cute.interface import _flash_attn_fwd, flash_attn_func
+
+IS_SM8X = torch.cuda.is_available() and torch.cuda.get_device_capability()[0] == 8
+pytestmark = pytest.mark.skipif(not IS_SM8X, reason="SM8x-only test")
+
+BLOCK = 128
+
+
+@cute.jit
+def key_valid_mask_mod(batch, head, m_idx, n_idx, seqlen_info, aux_tensors):
+    valid = aux_tensors[0]
+    val = fa_utils.scalar_to_ssa(valid[n_idx[0]], cutlass.Int32)
+    return val != fa_utils.scalar_to_ssa(0, cutlass.Int32)
+
+
+def make_pattern(H, M, N, k, p_partial, empty_rows=()):
+    """k kept KV blocks per (head, q-block) row (diagonal always kept), each partial w.p. p_partial.
+
+    Returns forward lists [1, H, M, k] (ascending, packed left) and a block map [H, M, N]
+    (0 skipped, 1 full, 2 partial)."""
+    k = min(k, N)
+    r = torch.rand(H, M, N, device="cuda")
+    rows = torch.arange(M, device="cuda")
+    r[:, rows, (rows * N) // M] = 2.0
+    kept = r.topk(k, dim=-1).indices.sort(dim=-1).values
+    is_partial = torch.rand(H, M, k, device="cuda") < p_partial
+    alive = torch.ones_like(is_partial)
+    for h, m in empty_rows:
+        alive[h, m] = False
+    part, full = is_partial & alive, ~is_partial & alive
+    big = N + 1
+    mask_idx = torch.where(part, kept, kept + big).sort(-1).values
+    full_idx = torch.where(full, kept, kept + big).sort(-1).values
+    bm = torch.zeros(H, M, N, dtype=torch.int8, device="cuda")
+    bm.scatter_(2, kept, torch.where(part, 2, torch.where(full, 1, 0)).to(torch.int8))
+    bst = BlockSparseTensorsTorch(
+        mask_block_cnt=part.sum(-1, dtype=torch.int32)[None],
+        mask_block_idx=torch.where(mask_idx < big, mask_idx, 0).to(torch.int32)[None],
+        full_block_cnt=full.sum(-1, dtype=torch.int32)[None],
+        full_block_idx=torch.where(full_idx < big, full_idx, 0).to(torch.int32)[None],
+        block_size=(BLOCK, BLOCK),
+    )
+    return bst, bm
+
+
+def reference(q, k, v, bm, valid):
+    """fp32 attention with the token-level mask; rows with no allowed key give 0."""
+    S, H, D = q.shape[1], q.shape[2], q.shape[3]
+    tb = torch.arange(S, device="cuda") // BLOCK
+    bt = bm[:, tb][:, :, tb]
+    allowed = (bt == 1) | ((bt == 2) & (valid[None, None, :] != 0))
+    s = torch.einsum("qhd,khd->hqk", q[0], k[0]) / math.sqrt(D)
+    p = torch.softmax(s.masked_fill(~allowed, -1e30), dim=-1) * allowed.any(-1, keepdim=True)
+    return torch.einsum("hqk,khd->qhd", p, v[0])[None]
+
+
+@pytest.mark.parametrize("seqlen", [946, 1000, 2048])
+@pytest.mark.parametrize("p_partial", [0.0, 0.3, 1.0])
+@pytest.mark.parametrize("tile_mn", [None, (64, 64), (128, 64)])
+def test_block_sparse_fwd_sm8x(seqlen, p_partial, tile_mn):
+    torch.manual_seed(0)
+    H, D = 2, 128
+    M = N = (seqlen + BLOCK - 1) // BLOCK
+    q, k, v = [torch.randn(1, seqlen, H, D, device="cuda", dtype=torch.bfloat16) for _ in range(3)]
+    valid = (torch.rand(seqlen, device="cuda") < 0.6).to(torch.int32)
+    bst, bm = make_pattern(H, M, N, 3, p_partial, empty_rows=[(1, M - 1)])
+    out, lse, *_ = _flash_attn_fwd(
+        q, k, v, block_sparse_tensors=bst, mask_mod=key_valid_mask_mod, aux_tensors=[valid],
+        tile_mn=tile_mn, return_lse=True,
+    )
+    ref = reference(q.float(), k.float(), v.float(), bm, valid)
+    assert (out.float() - ref).abs().max().item() < 2e-2
+    # not the silent dense fallback
+    dense = flash_attn_func(q, k, v)[0]
+    assert (dense.float() - ref).abs().max().item() > 0.1
+    # empty row: O = 0, LSE = -inf
+    r0 = (M - 1) * BLOCK
+    assert (out[0, r0:, 1] == 0).all()
+    assert torch.isinf(lse[0, 1, r0:]).all()
+
+
+def test_block_sparse_fwd_sm8x_no_recompile():
+    torch.manual_seed(0)
+    S, H, D = 2048, 2, 128
+    M = N = S // BLOCK
+    q, k, v = [torch.randn(1, S, H, D, device="cuda", dtype=torch.bfloat16) for _ in range(3)]
+    valid = (torch.rand(S, device="cuda") < 0.6).to(torch.int32)
+    sizes = []
+    for kb in (3, 3, 5, 2, 9):
+        bst, bm = make_pattern(H, M, N, kb, 0.3)
+        out = flash_attn_func(q, k, v, block_sparse_tensors=bst, mask_mod=key_valid_mask_mod,
+                              aux_tensors=[valid])[0]
+        ref = reference(q.float(), k.float(), v.float(), bm, valid)
+        assert (out.float() - ref).abs().max().item() < 2e-2
+        sizes.append(len(_flash_attn_fwd.compile_cache.cache))
+    assert len(set(sizes)) == 1
+
+
+@pytest.mark.parametrize("seqlen", [946, 2048])
+@pytest.mark.parametrize("p_partial", [0.0, 0.3])
+def test_block_sparse_bwd_sm8x(seqlen, p_partial):
+    torch.manual_seed(0)
+    H, D = 2, 128
+    M = N = (seqlen + BLOCK - 1) // BLOCK
+    q, k, v = [
+        torch.randn(1, seqlen, H, D, device="cuda", dtype=torch.bfloat16, requires_grad=True)
+        for _ in range(3)
+    ]
+    do = torch.randn(1, seqlen, H, D, device="cuda", dtype=torch.bfloat16)
+    valid = (torch.rand(seqlen, device="cuda") < 0.6).to(torch.int32)
+    bst, bm = make_pattern(H, M, N, 3, p_partial, empty_rows=[(0, 1)])
+    out = flash_attn_func(
+        q, k, v, block_sparse_tensors=bst,
+        block_sparse_tensors_bwd=block_sparse_tensors_fwd_to_bwd(bst, M, N),
+        mask_mod=key_valid_mask_mod, aux_tensors=[valid],
+    )[0]
+    grads = torch.autograd.grad(out, (q, k, v), do)
+    qf, kf, vf = [x.detach().float().requires_grad_() for x in (q, k, v)]
+    ref = reference(qf, kf, vf, bm, valid)
+    ref_grads = torch.autograd.grad(ref, (qf, kf, vf), do.float())
+    for g, rg in zip(grads, ref_grads):
+        assert not torch.isnan(g).any()
+        assert (g.float() - rg).abs().max().item() < 2e-2 * max(1.0, rg.abs().max().item())
+
+
+def test_block_sparse_bwd_sm8x_requires_bwd_lists():
+    S, H, D = 1024, 2, 128
+    M = N = S // BLOCK
+    q, k, v = [
+        torch.randn(1, S, H, D, device="cuda", dtype=torch.bfloat16, requires_grad=True)
+        for _ in range(3)
+    ]
+    bst, _ = make_pattern(H, M, N, 3, 0.0)
+    out = flash_attn_func(q, k, v, block_sparse_tensors=bst)[0]
+    with pytest.raises(ValueError, match="block_sparse_tensors_bwd"):
+        out.sum().backward()
