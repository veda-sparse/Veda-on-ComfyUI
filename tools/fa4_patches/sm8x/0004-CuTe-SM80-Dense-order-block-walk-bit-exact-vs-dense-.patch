+# ---------------------------------------------------------------------------------------------
+# SM80-family block iteration (forward: descending KV blocks, backward: ascending Q blocks).
+#
+# Both input formats are walked as one merged, monotonic sequence of (block, is_partial), i.e.
+# in the same order as the dense SM80 kernels, so that a sparse run is bit-identical to the
+# dense kernel with an equivalent mask_mod (skipped tiles would only add exact zeros there).
+# The cursor state is four Int32 values so the loop can carry it without tuple pytrees.
+# ---------------------------------------------------------------------------------------------
+
+
+@cute.jit
+def build_block_bitmask_sm80(
+    mask_line: cute.Tensor,
+    partial_vec: Optional[cute.Tensor],
+    partial_all: Optional[Int32],
+    sKeep: cute.Tensor,
+    sPart: cute.Tensor,
+    tidx: Int32,
+    num_threads: cutlass.Constexpr[int],
+):
+    """Turn one uint8 row/column of a DenseBlockMask into smem bitmasks (1 bit per block).
+
+    mask_line: [L] uint8 (0 skip, 1 full, 2 partial). partial_vec: optional [L] uint8 that
+    marks blocks as partial per position (forward rows); partial_all: optional scalar that
+    marks every block partial (backward column of a partial KV block). Caller must barrier.
+    Returns the number of 32-bit words.
+    """
+    num_blocks = cute.size(mask_line.shape[0])
+    num_words = (num_blocks + 31) // 32
+    warp_idx = tidx // 32
+    lane = tidx % 32
+    for w in cutlass.range(warp_idx, num_words, num_threads // 32, unroll=1):
+        i = w * 32 + lane
+        code = Int32(0)
+        pflag = Int32(0)
+        if i < num_blocks:
+            code = Int32(mask_line[i])
+            if const_expr(partial_vec is not None):
+                pflag = Int32(partial_vec[i])
+        if const_expr(partial_all is not None):
+            pflag = pflag | partial_all
+        keep = code != 0
+        part = keep & ((code == 2) | (pflag != 0))
+        keep_bits = cute.arch.vote_ballot_sync(keep)
+        part_bits = cute.arch.vote_ballot_sync(part)
+        if lane == 0:
+            sKeep[w] = keep_bits
+            sPart[w] = part_bits
+    return num_words
+
+
+@cute.jit
+def bitmask_count_sm80(sKeep: cute.Tensor, num_words: Int32) -> Int32:
+    total = Int32(0)
+    for w in cutlass.range(num_words, unroll=1):
+        total = total + cute.arch.popc(sKeep[w])
+    return total
+
+
+@cute.jit
+def bitmask_pop_desc_sm80(sKeep: cute.Tensor, sPart: cute.Tensor, s0, s1, s2, s3):
+    """Next block in descending order. State: s0 = word index, s1 = unvisited bits of it.
+    Start with (num_words, 0, 0, 0). Returns (block or -1, is_partial, s0..s3)."""
+    w = s0
+    bits = s1
+    while (bits == 0) & (w > 0):
+        w = w - 1
+        bits = sKeep[w]
+    blk = Int32(-1)
+    part = Int32(0)
+    if bits != 0:
+        hb = Int32(cute.arch.bfind(cutlass.Uint32(bits)))
+        blk = w * 32 + hb
+        bits = bits & ~(Int32(1) << hb)
+        part = (sPart[w] >> hb) & Int32(1)
+    return blk, part, w, bits, s2, s3
+
+
+@cute.jit
+def bitmask_pop_asc_sm80(
+    sKeep: cute.Tensor, sPart: cute.Tensor, num_words: Int32, s0, s1, s2, s3
+):
+    """Next block in ascending order. Start with (-1, 0, 0, 0)."""
+    w = s0
+    bits = s1
+    while (bits == 0) & (w < num_words - 1):
+        w = w + 1
+        bits = sKeep[w]
+    blk = Int32(-1)
+    part = Int32(0)
+    if bits != 0:
+        low = bits & (Int32(0) - bits)
+        lb = Int32(cute.arch.bfind(cutlass.Uint32(low)))
+        blk = w * 32 + lb
+        bits = bits ^ low
+        part = (sPart[w] >> lb) & Int32(1)
+    return blk, part, w, bits, s2, s3
+
+
+@cute.jit
+def list_head_desc_sm80(cnt: Int32, idx: Optional[cute.Tensor], consumed: Int32) -> Int32:
+    head = Int32(-1)
+    if const_expr(idx is not None):
+        if consumed < cnt:
+            head = idx[cnt - 1 - consumed]
+    return head
+
+
+@cute.jit
+def list_pop_desc_sm80(
+    mask_cnt: Int32,
+    mask_idx: cute.Tensor,
+    full_cnt: Int32,
+    full_idx: Optional[cute.Tensor],
+    s0,
+    s1,
+    s2,
+    s3,
+):
+    """Merge the (ascending) partial and full lists into one descending walk.
+    State: s0/s1 = entries consumed from the partial/full list, s2/s3 = their current heads
+    (-1 when exhausted). Start with (0, 0, head(partial), head(full))."""
+    im = s0
+    jf = s1
+    cm = s2
+    cf = s3
+    blk = Int32(-1)
+    part = Int32(0)
+    if cm > cf:
+        blk = cm
+        part = Int32(1)
+        im = im + 1
+        cm = list_head_desc_sm80(mask_cnt, mask_idx, im)
+    else:
+        if cf >= 0:
+            blk = cf
+            jf = jf + 1
+            cf = list_head_desc_sm80(full_cnt, full_idx, jf)
+    return blk, part, im, jf, cm, cf
+
+
+_ASC_EXHAUSTED = 1 << 30
+
+
+@cute.jit
+def list_head_asc_sm80(cnt: Int32, idx: Optional[cute.Tensor], consumed: Int32) -> Int32:
+    head = Int32(_ASC_EXHAUSTED)
+    if const_expr(idx is not None):
+        if consumed < cnt:
+            head = idx[consumed]
+    return head
+
+
+@cute.jit
+def list_pop_asc_sm80(
+    mask_cnt: Int32,
+    mask_idx: cute.Tensor,
+    full_cnt: Int32,
+    full_idx: Optional[cute.Tensor],
+    s0,
+    s1,
+    s2,
+    s3,
+):
+    """Ascending merge (backward). Heads are _ASC_EXHAUSTED when a list is exhausted."""
+    im = s0
+    jf = s1
+    cm = s2
+    cf = s3
+    blk = Int32(-1)
+    part = Int32(0)
+    if cm < cf:
+        blk = cm
+        part = Int32(1)
+        im = im + 1
+        cm = list_head_asc_sm80(mask_cnt, mask_idx, im)
+    else:
+        if cf < _ASC_EXHAUSTED:
+            blk = cf
+            jf = jf + 1
+            cf = list_head_asc_sm80(full_cnt, full_idx, jf)
+    return blk, part, im, jf, cm, cf
+
+
 @cute.jit
 def split_block_range(block_count, split_idx: Int32, num_splits: Int32):
     """Return the half-open block-list range assigned to one SplitKV partition."""
