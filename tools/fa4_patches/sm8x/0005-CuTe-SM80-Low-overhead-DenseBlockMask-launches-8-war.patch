+@cute.jit
+def block_code_mask_mod(batch, head, m_idx, n_idx, seqlen_info, aux_tensors):
+    """Dense-kernel equivalent of a block-sparse run: aux[1] holds block codes [H, M, N] int32
+    (0 skip, 1 full, 2 partial -> key validity aux[0])."""
+    valid = aux_tensors[0]
+    codes = aux_tensors[1]
+    c = codes[head[0], m_idx[0] // BLOCK, n_idx[0] // BLOCK]
+    keep = (c == 1) or (c == 2 and valid[n_idx[0]] != 0)
+    return fa_utils.scalar_to_ssa(keep, cutlass.Boolean)
+
+
+def _codes_to_lists(codes, which):
+    sel = (codes == which).contiguous()
+    cnt = sel.sum(-1, dtype=torch.int32)
+    idx = torch.argsort(sel.to(torch.int8), dim=-1, descending=True, stable=True)
+    return cnt, idx.to(torch.int32).contiguous()
+
+
+def _block_codes(H, M, N, k, p_partial, seed):
+    torch.manual_seed(seed)
+    bst, bm = make_pattern(H, M, N, k, p_partial, empty_rows=[(0, M - 1)])
+    return bst, bm.to(torch.int32)
+
+
+@pytest.mark.parametrize("seqlen", [1000, 2048])
+@pytest.mark.parametrize("tile_mn", [(128, 32), (128, 64), (64, 64)])
+def test_block_sparse_fwd_sm8x_bitwise_vs_dense(seqlen, tile_mn):
+    """Lists and DenseBlockMaskTorch runs are bit-identical to the dense kernel with the same
+    pattern expressed as a mask_mod (same tile): blocks are visited in the dense order."""
+    H, D = 2, 128
+    M = N = (seqlen + BLOCK - 1) // BLOCK
+    q, k, v = [torch.randn(1, seqlen, H, D, device="cuda", dtype=torch.bfloat16) for _ in range(3)]
+    valid = (torch.rand(seqlen, device="cuda") < 0.6).to(torch.int32)
+    bst, codes = _block_codes(H, M, N, 3, 0.3, 1)
+    ref_o, ref_lse, *_ = _flash_attn_fwd(q, k, v, tile_mn=tile_mn, return_lse=True,
+                                         mask_mod=block_code_mask_mod, aux_tensors=[valid, codes])
+    for masks in (bst, DenseBlockMaskTorch(codes.to(torch.uint8)[None])):
+        o, lse, *_ = _flash_attn_fwd(q, k, v, tile_mn=tile_mn, return_lse=True,
+                                     block_sparse_tensors=masks, mask_mod=key_valid_mask_mod,
+                                     aux_tensors=[valid])
+        assert torch.equal(o, ref_o)
+        assert torch.equal(lse, ref_lse)
+
+
+@pytest.mark.parametrize("seqlen", [946, 2048])
+def test_dense_block_mask_fwd_bwd_sm8x(seqlen):
+    H, D = 2, 128
+    M = N = (seqlen + BLOCK - 1) // BLOCK
+    q, k, v = [
+        torch.randn(1, seqlen, H, D, device="cuda", dtype=torch.bfloat16, requires_grad=True)
+        for _ in range(3)
+    ]
+    do = torch.randn(1, seqlen, H, D, device="cuda", dtype=torch.bfloat16)
+    valid = (torch.rand(seqlen, device="cuda") < 0.6).to(torch.int32)
+    _, codes = _block_codes(H, M, N, 3, 0.3, 2)
+    # bool mask + per-KV-column partial flags must equal the uint8 code form
+    col_partial = torch.zeros(N, dtype=torch.bool, device="cuda")
+    col_partial[::2] = True
+    codes_col = torch.where(codes != 0, torch.where(col_partial, 2, 1), 0).to(torch.uint8)
+    for mask, bm in (
+        (DenseBlockMaskTorch(codes.to(torch.uint8)[None]), codes),
+        (DenseBlockMaskTorch((codes != 0)[None], col_partial), codes_col.to(torch.int32)),
+    ):
+        out, lse = flash_attn_func(q, k, v, block_sparse_tensors=mask, mask_mod=key_valid_mask_mod,
+                                   aux_tensors=[valid], return_lse=True)
+        grads = torch.autograd.grad(out, (q, k, v), do)
+        qf, kf, vf = [x.detach().float().requires_grad_() for x in (q, k, v)]
+        ref = reference(qf, kf, vf, bm.to(torch.int8), valid)
+        ref_grads = torch.autograd.grad(ref, (qf, kf, vf), do.float())
+        assert (out.float() - ref).abs().max().item() < 2e-2
+        assert torch.isinf(lse[0, 0, (M - 1) * BLOCK:]).all()  # empty row
+        for g, rg in zip(grads, ref_grads):
+            assert (g.float() - rg).abs().max().item() < 2e-2 * max(1.0, rg.abs().max().item())
+
+
